<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Suite" parallel="methods" thread-count="1">
	
	<listeners>
		<listener class-name="com.erp.listeners.ExtentListener"/>
	</listeners>
		
	<test name="Smoke Suite From Jenkins">
	
	<parameter name="browser" value="chrome"/>
	
		<groups>
			<run>
				<include name="Smoke"/>
			</run>
		</groups>
			
		<classes>
			<class name="com.erp.testcases.TC6_E_NoteSheetTestCase"/>
			<class name="com.erp.testcases.TC7_E_NoteSheetStatusTestCase"/>
        </classes>
     
  	</test> <!-- Test -->
  
</suite> <!-- Suite -->


